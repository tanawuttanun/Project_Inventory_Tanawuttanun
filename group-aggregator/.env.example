# พอร์ตของ Aggregation API (ตัวกลาง)
AGGREGATOR_PORT=6000

# รายการ REST API ของสมาชิกทุกคนในกลุ่ม คั่นด้วยเครื่องหมายจุลภาค
# ใส่ชื่อกำกับได้ด้วยรูปแบบ label=url
MEMBER_APIS=me=http://localhost:3021/api/products,student-b=http://192.168.1.21:5000/api/products,student-c=http://192.168.1.22:5000/api/products

# เวลารอสูงสุดต่อสมาชิก 1 คน (วินาที)
MEMBER_TIMEOUT=5

# ถ้าสมาชิกตั้ง API key ไว้ ให้ใส่ตรงนี้ (เว้นว่าง = ไม่ส่ง header)
MEMBER_API_KEY=
